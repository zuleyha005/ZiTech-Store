@model List<ECommerceMVC.Models.Customer>

<h1>Müşteriler</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    + Yeni Müşteri Ekle
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ad</th>
            <th>Email</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Id</td>
                <td>@customer.Name</td>
                <td>@customer.Email</td>

                <td>
                    <form asp-action="Delete"
                          asp-route-id="@customer.Id"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-danger">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>