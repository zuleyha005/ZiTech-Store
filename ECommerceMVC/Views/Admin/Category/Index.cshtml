@model List<ECommerceMVC.Models.Category>

<h1>Kategoriler</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    + Yeni Kategori Ekle
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Kategori Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning">
                        Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>