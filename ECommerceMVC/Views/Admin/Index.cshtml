@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container mt-4">

    <h2>Admin Paneli</h2>

    <hr />

    <div class="row">

        <div class="col-md-3 mb-3">
            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary w-100">
                Ürünler
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a asp-controller="Category"
               asp-action="Index"
               class="btn btn-primary w-100">
                Kategoriler
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a asp-controller="Customer"
               asp-action="Index"
               class="btn btn-primary w-100">
                Müşteriler
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a asp-controller="Cart"
               asp-action="Index"
               class="btn btn-primary w-100">
                Sepetler
            </a>
        </div>

    </div>

</div>