@model List<ECommerceMVC.Models.Cart>

<h1>Sepet</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    + Yeni Sepet Ekle
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Müşteri ID</th>
            <th>Ürün ID</th>
            <th>Adet</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cart in Model)
        {
            <tr>
                <td>@cart.Id</td>
                <td>@cart.CustomerId</td>
                <td>@cart.ProductId</td>
                <td>@cart.Quantity</td>

                <td>
                    <form asp-action="Delete"
                          asp-route-id="@cart.Id"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-danger">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>