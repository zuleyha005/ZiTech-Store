<style>
    .store-header {
        background-color: #212529;
        padding: 18px 30px;
        color: white;
    }

    .product-image {
        width: 70px;
        height: 70px;
        object-fit: contain;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 5px;
    }

    .buy-button {
        background-color: #0d6efd;
        color: white;
        border: none;
    }

    .buy-button:hover {
        background-color: #0b5ed7;
        color: white;
    }

    .product-card {
        background-color: #ffffff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        height: 100%;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    .product-card-image {
        width: 100%;
        height: 190px;
        object-fit: contain;
        padding: 15px;
        background-color: #f8f9fa;
    }

    .product-card-body {
        padding: 15px;
    }

    .product-card-title {
        font-size: 16px;
        font-weight: 600;
        min-height: 42px;
        margin-bottom: 8px;
    }

    .product-card-description {
        color: #6c757d;
        font-size: 13px;
        min-height: 38px;
    }

    .product-card-price {
        color: #b12704;
        font-size: 18px;
        font-weight: bold;
        margin: 12px 0;
    }

    .buy-button {
        background-color: #198754;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 7px 15px;
    }

    .buy-button:hover {
        background-color: #2d5234;
        color: white;
    }

    body {
        background-color: #f7f5ef;
    }

    main {
        background-color: #f7f5ef;
    }

    .container {
        background-color: transparent;
    }
</style>

<div class="container mt-4">

    <h2 class="text-center mb-4">
        ⭐ Öne Çıkan Ürünler
    </h2>

    <div class="row">

        @foreach (var product in Model)
        {
            <div class="col-md-3 mb-4">

                <div class="product-card">

                    <img src="@GetProductImage(product.Name ?? "")" alt="@product.Name" class="product-card-image" />

                    <div class="product-card-body">

                        <h5 class="product-card-title">
                            @product.Name
                        </h5>

                        <div class="product-card-price">
                            @product.Price ₺
                        </div>

                        <button type="button" class="btn buy-button btn-sm" onclick="addToCart(@product.Id)">
                            🛒 Sepete Ekle
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
<script>
    async function addToCart(productId) {
        try {
            const response = await fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId
                })
            });

            if (response.ok) {
                window.location.href = '/Cart';
            }
            else if (response.status === 401) {
                window.location.href = '/Account/Login';
            }
            else {
                alert("Ürün sepete eklenirken bir hata oluştu.");
            }
        }
        catch (error) {
            console.error(error);
            alert("Sunucuya bağlanırken bir hata oluştu.");
        }
    }
</script>