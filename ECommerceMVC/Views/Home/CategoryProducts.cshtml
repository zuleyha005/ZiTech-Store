@{
    ViewData["Title"] = ViewBag.CategoryName;
}

<div class="container mt-4">

    <!-- Kategori Başlığı -->
    <h2 class="section-title text-center">
        @ViewBag.CategoryName Ürünleri
    </h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning mt-4">
            Bu kategoride ürün bulunamadı.
        </div>
    }
    else
    {
        <!-- Ürün Kartları -->
        <div class="row product-grid">

            @foreach (var product in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4">

                    <div class="product-card">

                        <!-- Ürün Fotoğrafı -->
                        <div class="product-image-container">
                            <img src="@GetProductImage(product.Name ?? "")" alt="@product.Name" class="product-image" />
                        </div>

                        <!-- Ürün Bilgileri -->
                        <div class="product-info">

                            <div class="product-name">
                                @product.Name
                            </div>

                            <div class="product-price">
                                @product.Price ₺
                            </div>

                            <button type="button" class="buy-button" onclick="addToCart(@product.Id)">
                                🛒 Sepete Ekle
                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>
    body {
    background-color: #f7f5ef;
}

main {
    background-color: #f7f5ef;
}

.container {
    background-color: transparent;
}

    /* Kategori başlığı */

    .category-title {
        background-color: #596166;
        color: white;
        font-weight: bold;
        padding: 10px 15px;
        border-radius: 4px;
        margin-bottom: 20px;
    }


    /* Ürünlerin bulunduğu alan */

    .product-grid {
